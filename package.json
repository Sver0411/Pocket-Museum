{
  "name": "pocket-museum",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && npm run build:standalone && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:assets": "node scripts/verify-assets.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "test:production": "node scripts/verify-production.mjs",
    "package:release": "python3 scripts/package-html-release.py",
    "verify": "npm run verify:assets && tsc -b"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "fake-indexeddb": "6.2.4",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
